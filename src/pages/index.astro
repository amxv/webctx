---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";
import "../styles/global.css";

const docs = (await getCollection("docs"))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((entry) => ["quickstart", "search", "read-link", "map-site", "ranking", "agent-workflows"].includes(entry.id));

const commands = [
  {
    index: "01",
    command: "search",
    line: 'webctx search "durable agent runtimes"',
    title: "Ask three search engines, not one.",
    body: "Brave, Tavily, and Exa run concurrently. URLs are normalized, duplicates become agreement signals, and one deterministic ranked list comes back."
  },
  {
    index: "02",
    command: "read-link",
    line: "webctx read-link <url>",
    title: "Turn a page into useful text.",
    body: "GitHub repositories, source, Issues, PRs, history, and Actions get native low-noise reads. Direct markdown stays cheap; unsupported pages fall back to Firecrawl."
  },
  {
    index: "03",
    command: "map-site",
    line: "webctx map-site <url>",
    title: "Survey the terrain before reading.",
    body: "Map a documentation or product site into a URL inventory, then let the agent choose which pages are worth opening."
  }
];

const workflow = [
  ["Search", "Fan one question out across providers."],
  ["Rank", "Reward independent agreement and remove duplicates."],
  ["Read", "Convert the useful pages into markdown."],
  ["Reuse", "Pipe, diff, store, quote, or hand the output to an agent."]
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <div class="webctx-home">
    <section class="wc-hero shell" aria-labelledby="hero-title">
      <div class="wc-hero__copy wc-reveal">
        <div class="wc-eyebrow">
          <span class="wc-eyebrow__dot" aria-hidden="true"></span>
          <span>Federated web context for agents</span>
          <span class="wc-eyebrow__version">Go · CLI · v0.1.1</span>
        </div>

        <h1 id="hero-title">
          The web,
          <em>distilled</em>
          for agents.
        </h1>

        <p class="wc-hero__lede">
          Search across Brave, Tavily, and Exa. Read any useful page as clean markdown.
          Map an entire site before deciding where to look. Three verbs, one small binary.
        </p>

        <div class="wc-hero__actions">
          <a class="wc-button wc-button--primary" href="/docs/quickstart">
            <span>Get started</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 3.5 13 8l-4.5 4.5" /></svg>
          </a>
          <a class="wc-button wc-button--secondary" href="https://github.com/amxv/webctx" target="_blank" rel="noreferrer">
            <span>View source</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="wc-install" data-copy-shell>
          <span class="wc-install__prompt" aria-hidden="true">$</span>
          <code>npm i -g webctx</code>
          <button class="wc-copy" type="button" data-copy-value="npm i -g webctx" aria-label="Copy install command">
            <svg class="wc-copy__icon" viewBox="0 0 18 18" aria-hidden="true">
              <rect x="6.5" y="6.5" width="8" height="8" rx="1.5" />
              <path d="M4.5 11.5h-1a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v1" />
            </svg>
            <span data-copy-label>Copy</span>
          </button>
        </div>
      </div>

      <div class="wc-hero__visual wc-reveal" style="--reveal-delay: 120ms" aria-label="Three search providers merging into a ranked result list">
        <div class="wc-orbit wc-orbit--one" aria-hidden="true"></div>
        <div class="wc-orbit wc-orbit--two" aria-hidden="true"></div>

        <div class="wc-console">
          <div class="wc-console__chrome">
            <div class="wc-console__lights" aria-hidden="true"><i></i><i></i><i></i></div>
            <span>webctx / search</span>
            <span class="wc-console__live"><i></i> live</span>
          </div>

          <div class="wc-query">
            <span aria-hidden="true">›</span>
            <code>webctx search "agent web research"</code>
            <i aria-hidden="true"></i>
          </div>

          <div class="wc-signal-board">
            <div class="wc-providers">
              <div class="wc-provider wc-provider--brave">
                <span class="wc-provider__index">B</span>
                <div><strong>Brave</strong><small>10 results · 184ms</small></div>
                <span class="wc-provider__pulse" aria-hidden="true"></span>
              </div>
              <div class="wc-provider wc-provider--tavily">
                <span class="wc-provider__index">T</span>
                <div><strong>Tavily</strong><small>10 results · 241ms</small></div>
                <span class="wc-provider__pulse" aria-hidden="true"></span>
              </div>
              <div class="wc-provider wc-provider--exa">
                <span class="wc-provider__index">E</span>
                <div><strong>Exa</strong><small>10 results · 207ms</small></div>
                <span class="wc-provider__pulse" aria-hidden="true"></span>
              </div>
            </div>

            <div class="wc-merge" aria-hidden="true">
              <span class="wc-merge__line wc-merge__line--top"></span>
              <span class="wc-merge__line wc-merge__line--middle"></span>
              <span class="wc-merge__line wc-merge__line--bottom"></span>
              <span class="wc-merge__spine"></span>
              <span class="wc-merge__node">∑</span>
            </div>

            <div class="wc-output">
              <div class="wc-output__head">
                <span>ranked.md</span>
                <span>30 → 18 unique</span>
              </div>
              <ol>
                <li>
                  <span class="wc-rank">01</span>
                  <div><strong>Building reliable web research agents</strong><small>docs.example.dev / research</small></div>
                  <span class="wc-agreement">3×</span>
                </li>
                <li>
                  <span class="wc-rank">02</span>
                  <div><strong>Context pipelines for tool-using models</strong><small>github.com / guide.md</small></div>
                  <span class="wc-agreement">2×</span>
                </li>
                <li>
                  <span class="wc-rank">03</span>
                  <div><strong>Evaluating agent search quality</strong><small>example.org / benchmarks</small></div>
                  <span class="wc-agreement wc-agreement--single">1×</span>
                </li>
              </ol>
            </div>
          </div>

          <div class="wc-console__foot">
            <span><i></i> normalized URLs</span>
            <span><i></i> duplicate bonus</span>
            <span><i></i> deterministic ties</span>
          </div>
        </div>

        <div class="wc-note wc-note--top" aria-hidden="true">
          <span>03 providers</span>
          <strong>one query</strong>
        </div>
        <div class="wc-note wc-note--bottom" aria-hidden="true">
          <span>output</span>
          <strong>plain markdown</strong>
        </div>
      </div>
    </section>

    <div class="wc-command-rail" aria-label="Core commands">
      <div class="wc-command-rail__track">
        <span>search</span><i>◆</i><span>read-link</span><i>◆</i><span>map-site</span><i>◆</i>
        <span>search</span><i>◆</i><span>read-link</span><i>◆</i><span>map-site</span><i>◆</i>
      </div>
    </div>

    <section class="wc-thesis shell wc-section" aria-labelledby="thesis-title">
      <header class="wc-section-head wc-reveal">
        <p class="wc-kicker">01 / Why federated search</p>
        <p class="wc-section-note">Independent agreement is a stronger relevance signal than any provider's confidence score.</p>
      </header>

      <div class="wc-thesis__grid">
        <h2 id="thesis-title" class="wc-reveal">
          No single search provider is right
          <em>often enough.</em>
        </h2>
        <div class="wc-thesis__copy wc-reveal" style="--reveal-delay: 80ms">
          <p>
            webctx treats provider disagreement as useful information. It asks three systems the same
            question, normalizes their URLs, and rewards the pages they independently surface.
          </p>
          <p>
            The result is not three pasted lists. It is one stable, deduplicated answer an agent can
            inspect, save, diff, and cite.
          </p>
        </div>
      </div>

      <div class="wc-consensus wc-reveal" style="--reveal-delay: 140ms">
        <div class="wc-consensus__legend">
          <span><i class="is-brave"></i> Brave</span>
          <span><i class="is-tavily"></i> Tavily</span>
          <span><i class="is-exa"></i> Exa</span>
        </div>
        <div class="wc-consensus__rows">
          <div class="wc-consensus-row">
            <span class="wc-consensus-row__url">docs.example.dev/agent-search</span>
            <div class="wc-consensus-row__signals"><i class="is-brave"></i><i class="is-tavily"></i><i class="is-exa"></i></div>
            <span class="wc-consensus-row__score">+ agreement bonus</span>
          </div>
          <div class="wc-consensus-row">
            <span class="wc-consensus-row__url">github.com/example/research-agent</span>
            <div class="wc-consensus-row__signals"><i class="is-brave"></i><i class="is-tavily"></i><i></i></div>
            <span class="wc-consensus-row__score">+ duplicate signal</span>
          </div>
          <div class="wc-consensus-row">
            <span class="wc-consensus-row__url">example.org/context-tools</span>
            <div class="wc-consensus-row__signals"><i></i><i class="is-tavily"></i><i></i></div>
            <span class="wc-consensus-row__score is-muted">position score only</span>
          </div>
        </div>
      </div>
    </section>

    <section class="wc-commands wc-section" aria-labelledby="commands-title">
      <div class="shell">
        <header class="wc-section-head wc-reveal">
          <p class="wc-kicker">02 / The whole interface</p>
          <p class="wc-section-note">Small enough to learn from <code>--help</code>. Broad enough for an entire research loop.</p>
        </header>
        <div class="wc-commands__title-row">
          <h2 id="commands-title" class="wc-reveal">Three verbs.<br /><em>Nothing ornamental.</em></h2>
          <p class="wc-reveal" style="--reveal-delay: 80ms">
            Each command exists because a real agent workflow needed it. The output stays plain so the next tool never has to scrape the first one.
          </p>
        </div>

        <div class="wc-command-cards">
          {commands.map((item, index) => (
            <article class="wc-command-card wc-reveal" style={`--reveal-delay: ${index * 70}ms`}>
              <div class="wc-command-card__top">
                <span>{item.index}</span>
                <span>webctx / {item.command}</span>
              </div>
              <div class="wc-command-card__glyph" aria-hidden="true">
                {item.command === "search" && (
                  <svg viewBox="0 0 120 120"><circle cx="51" cy="51" r="29" /><path d="m73 73 27 27" /><path d="M51 31v40M31 51h40" /></svg>
                )}
                {item.command === "read-link" && (
                  <svg viewBox="0 0 120 120"><path d="M39 67 27 79a19 19 0 0 0 27 27l18-18a19 19 0 0 0 0-27" /><path d="m81 53 12-12a19 19 0 0 0-27-27L48 32a19 19 0 0 0 0 27" /><path d="m45 75 30-30" /></svg>
                )}
                {item.command === "map-site" && (
                  <svg viewBox="0 0 120 120"><rect x="46" y="10" width="28" height="22" /><rect x="10" y="88" width="28" height="22" /><rect x="46" y="88" width="28" height="22" /><rect x="82" y="88" width="28" height="22" /><path d="M60 32v30M24 62h72M24 62v26M60 62v26M96 62v26" /></svg>
                )}
              </div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <code class="wc-command-card__line"><span>$</span> {item.line}</code>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="wc-gradient shell wc-section" aria-labelledby="gradient-title">
      <header class="wc-section-head wc-reveal">
        <p class="wc-kicker">03 / Read-link cost gradient</p>
        <p class="wc-section-note">Do the cheapest correct thing first. Render the web only when plain text is not already available.</p>
      </header>

      <div class="wc-gradient__layout">
        <div class="wc-gradient__copy wc-reveal">
          <h2 id="gradient-title">Don’t scrape what you can <em>just fetch.</em></h2>
          <p>
            Most agent reading is documentation, repository context, source, and code-review discussion. webctx interprets supported GitHub URLs directly, checks markdown paths next, and pays the latency and cost of browser-grade extraction only when it has to.
          </p>
          <a href="/docs/read-link">See the read-link pipeline <span aria-hidden="true">→</span></a>
        </div>

        <div class="wc-path wc-reveal" style="--reveal-delay: 100ms">
          <div class="wc-path__rail" aria-hidden="true"><span></span></div>
          <article class="wc-path-step wc-path-step--fast">
            <span class="wc-path-step__number">01</span>
            <div>
              <p>GitHub repo, source, Issue, or PR view?</p>
              <strong>Read the selected resource natively</strong>
              <small>Source · conversations · diffs · history · Actions logs</small>
            </div>
            <span class="wc-path-step__badge">preferred</span>
          </article>
          <article class="wc-path-step wc-path-step--fast">
            <span class="wc-path-step__number">02</span>
            <div>
              <p>Markdown-style page?</p>
              <strong>Try the .md path</strong>
              <small>Fast · clean · free</small>
            </div>
            <span class="wc-path-step__badge">preferred</span>
          </article>
          <article class="wc-path-step wc-path-step--fallback">
            <span class="wc-path-step__number">03</span>
            <div>
              <p>Normal web page?</p>
              <strong>Fall back to Firecrawl</strong>
              <small>Rendered · extracted · robust</small>
            </div>
            <span class="wc-path-step__badge">fallback</span>
          </article>
          <div class="wc-path__result">
            <span aria-hidden="true">↓</span>
            <strong>clean markdown</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="wc-workflow wc-section" aria-labelledby="workflow-title">
      <div class="shell">
        <header class="wc-section-head wc-reveal">
          <p class="wc-kicker">04 / The research loop</p>
          <p class="wc-section-note">Terminal-native context means every output is already composable.</p>
        </header>
        <h2 id="workflow-title" class="wc-workflow__title wc-reveal">From a fuzzy question to reusable evidence.</h2>
        <div class="wc-workflow__steps">
          {workflow.map(([title, body], index) => (
            <article class="wc-workflow-step wc-reveal" style={`--reveal-delay: ${index * 60}ms`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="wc-docs shell wc-section" aria-labelledby="docs-title">
      <div class="wc-docs__intro wc-reveal">
        <p class="wc-kicker">05 / Documentation</p>
        <h2 id="docs-title">Learn the surface.<br /><em>Inspect the machinery.</em></h2>
        <p>
          Start with a working command, then go as deep as you need: credentials, ranking math, extraction paths, site mapping, and agent workflow recipes.
        </p>
        <a class="wc-button wc-button--secondary" href="/docs">
          <span>Browse every guide</span><span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="wc-docs__list wc-reveal" style="--reveal-delay: 100ms">
        {docs.map((entry, index) => (
          <a class="wc-doc-row" href={`/docs/${entry.id}`}>
            <span class="wc-doc-row__index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <span class="wc-doc-row__category">{entry.data.category}</span>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.summary ?? entry.data.description}</p>
            </div>
            <span class="wc-doc-row__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="wc-closing shell wc-reveal" aria-labelledby="closing-title">
      <div class="wc-closing__mark" aria-hidden="true">W/C</div>
      <div class="wc-closing__copy">
        <p class="wc-kicker">Ready when your agent is</p>
        <h2 id="closing-title">Give it a better view of the web.</h2>
        <div class="wc-closing__actions">
          <div class="wc-install wc-install--dark" data-copy-shell>
            <span class="wc-install__prompt" aria-hidden="true">$</span>
            <code>npm i -g webctx</code>
            <button class="wc-copy" type="button" data-copy-value="npm i -g webctx" aria-label="Copy install command">
              <svg class="wc-copy__icon" viewBox="0 0 18 18" aria-hidden="true">
                <rect x="6.5" y="6.5" width="8" height="8" rx="1.5" />
                <path d="M4.5 11.5h-1a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v1" />
              </svg>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <a href="/docs/quickstart">Read the quickstart <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </div>

  <script>
    const copyButtons = document.querySelectorAll<HTMLButtonElement>("[data-copy-value]");

    for (const button of copyButtons) {
      button.addEventListener("click", async () => {
        const value = button.dataset.copyValue;
        const label = button.querySelector<HTMLElement>("[data-copy-label]");
        if (!value || !label) return;

        try {
          await navigator.clipboard.writeText(value);
          label.textContent = "Copied";
          button.closest("[data-copy-shell]")?.classList.add("is-copied");
          window.setTimeout(() => {
            label.textContent = "Copy";
            button.closest("[data-copy-shell]")?.classList.remove("is-copied");
          }, 1600);
        } catch {
          label.textContent = "Select";
        }
      });
    }

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealItems = document.querySelectorAll<HTMLElement>(".wc-reveal");

    if (reducedMotion || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.12 });

      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</BaseLayout>
