{
  "name": "webctx",
  "version": "0.3.0",
  "description": "Go CLI for agent-friendly web research, structured-data discovery, and source-native querying",
  "license": "Apache-2.0",
  "author": "amxv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amxv/webctx.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/amxv/webctx#readme",
  "bugs": {
    "url": "https://github.com/amxv/webctx/issues"
  },
  "bin": {
    "webctx": "bin/webctx.js"
  },
  "config": {
    "cliBinaryName": "webctx"
  },
  "files": [
    "bin/webctx.js",
    "scripts/postinstall.js",
    "cmd",
    "internal",
    "go.mod",
    "go.sum",
    "pkg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node --check bin/webctx.js && node --check scripts/postinstall.js && node --test scripts/postinstall.test.js scripts/prepare-package.test.mjs",
    "lint": "npm run test",
    "prepare:package": "node scripts/prepare-package.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "go",
    "cli",
    "search",
    "web-search",
    "firecrawl",
    "exa",
    "tavily",
    "brave-search",
    "agent-tools",
    "npm",
    "release"
  ]
}
